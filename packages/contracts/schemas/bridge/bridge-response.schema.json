{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://minecraft-plugin-dev-mcp/schemas/bridge/bridge-response.schema.json",
  "title": "Bridge response",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "request_id",
    "correlation_id",
    "ok",
    "server_instance_id",
    "bridge_boot_id",
    "server_tick",
    "warnings"
  ],
  "properties": {
    "request_id": { "type": "string" },
    "correlation_id": { "type": "string" },
    "ok": { "type": "boolean" },
    "server_instance_id": { "type": "string", "pattern": "^srv_[A-Za-z0-9]+$" },
    "bridge_boot_id": { "type": "string", "pattern": "^boot_[A-Za-z0-9]+$" },
    "server_tick": { "type": "integer", "minimum": 0 },
    "data": {},
    "error": { "$ref": "../common/tool-error.schema.json" },
    "warnings": { "type": "array", "items": { "type": "string" } }
  },
  "allOf": [
    {
      "if": { "properties": { "ok": { "const": true } }, "required": ["ok"] },
      "then": { "required": ["data"], "not": { "required": ["error"] } }
    },
    {
      "if": { "properties": { "ok": { "const": false } }, "required": ["ok"] },
      "then": { "required": ["error"], "not": { "required": ["data"] } }
    }
  ]
}
